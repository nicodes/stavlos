{
  "version": 1,
  "recipe": "go-cli",
  "repository": "nicodes/stavlos",
  "tools": {
    "node": "22.20.0",
    "actionlint": "1.7.12",
    "shellcheck": "0.11.0"
  },
  "verification": {
    "version": 1,
    "full_targets": [
      "lint",
      "test",
      "artifact-check"
    ],
    "always": [
      "lint"
    ],
    "rules": [
      {
        "paths": [
          "README.md",
          "AGENTS.md"
        ],
        "targets": [
          "lint"
        ]
      }
    ],
    "force_full": []
  },
  "tasks": {
    "test-stability": [
      [
        "go",
        "test",
        "-race",
        "-count=3",
        "./..."
      ]
    ]
  },
  "stages": {
    "install": [
      [
        "go",
        "mod",
        "download"
      ],
      [
        "npm",
        "--prefix",
        "web",
        "ci",
        "--no-audit",
        "--no-fund"
      ]
    ],
    "lint": [
      [
        "bash",
        "scripts/check.sh",
        "lint"
      ],
      [
        "actionlint"
      ],
      [
        "shellcheck",
        "scripts/check.sh"
      ]
    ],
    "unit": [
      [
        "python3",
        "scripts/check_gate_test.py"
      ],
      [
        "bash",
        "scripts/check.sh",
        "test"
      ]
    ],
    "build": [
      [
        "bash",
        "scripts/check.sh",
        "build"
      ]
    ],
    "vuln": {
      "inapplicable": "The lint gate runs the module-pinned vulnerability scanner with execution-error controls"
    },
    "dev": {
      "inapplicable": "Interactive CLI sessions require caller-owned terminal and configuration"
    },
    "stop": {
      "inapplicable": "The CLI owns no background development service"
    },
    "clean": [
      [
        "python3",
        "-c",
        "import shutil; [shutil.rmtree(p,ignore_errors=True) for p in (\"dist\",\".artifacts\",\"web/node_modules\")]"
      ]
    ]
  },
  "validation": {
    "workflow": {
      "required": [
        "ci.yml",
        "dependency-policy.yml",
        "release.yml"
      ],
      "ci_gates": [
        "Test"
      ]
    }
  }
}
