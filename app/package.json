{
  "name": "stavlos-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run build:sheet && vite build",
    "test": "vitest run",
    "build:sheet": "tailwindcss -i sheet.input.css -o public/sheet.css --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@tailwindcss/cli": {
      "@parcel/watcher": "2.6.0"
    }
  }
}
